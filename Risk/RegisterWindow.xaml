<Window x:Class="Risk.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Risk"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="700" Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        x:Name="windowReg"
        Loaded="windowReg_Loaded">
    
    
    <Window.Resources>
        <Style x:Key="IconButtonNoHover" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="0"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3dbdbb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAA"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3dbdbb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAA"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#3dbdbb"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="White" BorderThickness="6" CornerRadius="20" SnapsToDevicePixels="True">
        <Border.Background>
            <ImageBrush ImageSource="Assets/taula_fusta.png" Stretch="Fill"/>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Nom" FontSize="25" Margin="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="Cognom" Grid.Row="1" FontSize="25" Margin="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="Email" Grid.Row="2" FontSize="25" Margin="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="Nom d'usuari" Grid.Row="3" FontSize="25" Margin="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="Contrassenya" Grid.Row="4" FontSize="25" Margin="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBox x:Name="txbNom" Style="{StaticResource RoundedTextBoxStyle}" FontSize="25" Grid.Column="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="7"></TextBox>
                <TextBox x:Name="txbCognom" Style="{StaticResource RoundedTextBoxStyle}" FontSize="25" Grid.Column="1" Grid.Row="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="7"></TextBox>
                <TextBox x:Name="txbEmail" Style="{StaticResource RoundedTextBoxStyle}" FontSize="25" Grid.Column="1" Grid.Row="2" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="7"></TextBox>
                <TextBox x:Name="txbUsuari" Style="{StaticResource RoundedTextBoxStyle}" FontSize="25" Grid.Column="1" Grid.Row="3" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="7"></TextBox>
                <PasswordBox x:Name="txbPwd" Style="{StaticResource RoundedPasswordBoxStyle}" FontSize="25" Grid.Column="1" Grid.Row="4" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="7"></PasswordBox>
            </Grid>


            <Grid Grid.Column="1" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Background="Transparent"
                    Style="{StaticResource IconButtonNoHover}"
                    Cursor="Hand"
                    BorderThickness="0"
                    Padding="5"
                    HorizontalAlignment="Center"
                    Click="btn_next_click">
                    <Image
                      Width="150" Height="130"
                        Stretch="Fill"
                      Source="Assets/arrow_up.png"/>
                </Button>

                <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        Width="300" Height="300"
                        CornerRadius="150"
                        BorderBrush="White"
                        BorderThickness="4">
                        <Border.Background>
                            <ImageBrush
                                ImageSource="{Binding ElementName=windowReg, Path=currentAvatar.Url, FallbackValue=https://raw.githubusercontent.com/jonah3d/riskimg/refs/heads/main/imge1.png}"
                                Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <Button
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="5"
                    HorizontalAlignment="Center"
                    Style="{StaticResource IconButtonNoHover}"
                    Cursor="Hand"
                    Click="btn_before_click">
                    <Image
                      Width="150" Height="130"
                        Stretch="Fill"
                      Source="Assets/arrow_down.png"/>
                </Button>
            </Grid>

            <Button Click="btn_crear_click" Grid.Row="3" Grid.Column="1" Content="Crear" Style="{StaticResource RoundedButtonStyle}" HorizontalAlignment="Center" Width="140" Height="45"/>
            <Button Click="btn_cancel_click" Grid.Row="3" Grid.Column="0" Margin="50" Content="Cancelar" Style="{StaticResource RoundedButtonStyle}" HorizontalAlignment="Center" Width="140" Height="45"/>

            <Grid x:Name="LoadingOverlay"
                      Grid.ColumnSpan="2" Grid.RowSpan="4"
                          Background="#80000000"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <ProgressBar IsIndeterminate="True"
                   Width="120" Height="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
