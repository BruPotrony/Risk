<UserControl x:Class="Risk.views.UCListPlayers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Risk.views"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="350"
             Foreground="White"
             Name="ucJugadors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Border
      CornerRadius="15"
      BorderThickness="4"
      BorderBrush="Transparent"
      SnapsToDevicePixels="True"
    x:Name="borderTauler"
    Cursor="Hand"
        Background="{Binding ElementName=ucJugadors, Path=MyJugador.ColorBrush, FallbackValue=Orange}">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Text="▶️" FontSize="60" VerticalAlignment="Center" Visibility="{Binding MyJugador.isHisTurn, 
                                                                           RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                                           Converter={StaticResource BoolToVis}}"></TextBlock>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                <TextBlock Text="Jugador: " FontSize="15"  FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding ElementName=ucJugadors, Path=MyJugador.SkfUser.Username, FallbackValue=bpotrony}" TextWrapping="Wrap" FontSize="15"  FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>
            


            <Grid Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Width="80"
                    Height="80"
                    CornerRadius="150"
                    BorderBrush="White"
                    BorderThickness="4"
                    Margin="10,0">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="{Binding ElementName=ucJugadors, Path=MyJugador.SkfUser.Avatar, FallbackValue=https://raw.githubusercontent.com/jonah3d/riskimg/refs/heads/main/imge1.png}"
                            Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
